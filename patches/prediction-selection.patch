+        /// <summary>
+        /// Returns true if the list view currently has an item selected.
+        /// Callers that own a key can use this to decide between 'PreviousSuggestion'
+        /// and their own behavior: while a selection exists, the arrow keys navigate
+        /// the list instead of doing whatever the caller binds them to.
+        /// </summary>
+        public static bool HasPredictionSelection()
+        {
+            return _singleton._prediction.ActiveView is PredictionListView listView
+                && listView.HasActiveSuggestion
+                && listView.SelectedItemIndex >= 0;
+        }
